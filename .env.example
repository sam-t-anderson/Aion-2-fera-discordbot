DISCORD_TOKEN=paste-your-bot-token-here
# Only needed when upgrading from the single-server version: your old server's ID, so its data moves over.
# Leave empty on a new install. The bot works in every server it is invited to.
GUILD_ID=
# Checklist reset hour in UTC. 13 = 7:00 AM MDT / 6:00 AM MST. 14 = 8:00 AM MDT / 7:00 AM MST.
RESET_UTC_HOUR=13
# Weekly reset day: Monday=0, Tuesday=1, Wednesday=2, Thursday=3, Friday=4, Saturday=5, Sunday=6
WEEKLY_RESET_WEEKDAY=0
# Only used once when upgrading: becomes that server's notices channel. Each server now picks its own with /setup announcements.
ANNOUNCE_CHANNEL_ID=

# Timezone used when someone types an event time and hasn't run /timezone set
DEFAULT_TZ=America/Denver
# Minutes before an event starts to DM people who pressed Alert me
EVENT_ALERT_MINUTES=15

# Which timer categories to track from gamers4.life. * = everything, including categories added later.
# Or list some, like: Rifts,World Bosses,Abyss
# Which game version's schedule to track. The page states its version; any other is ignored.
TIMERS_REGION=Global
TIMER_CATEGORIES=*
# How often the live timer board from /timer-setup is edited (minutes, 1 or more)
TIMER_BOARD_MINUTES=2
# How often the /dkp-setup board is re-checked (it also updates a few seconds after any change)
DKP_BOARD_MINUTES=2
TIMER_REFRESH_MINUTES=15
TIMER_RETENTION_DAYS=7

# Port on the server where Uptime Kuma and Homepage check the bot
HEALTH_HOST_PORT=8099
